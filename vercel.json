{
  "cleanUrls": true,
  "functions": {
    "api/admin/config-status.js": {
      "includeFiles": "supabase/migrations/probes.json"
    }
  },
  "crons": [
    {
      "path": "/api/analytics/sync",
      "schedule": "0 */12 * * *"
    },
    {
      "path": "/api/cron/purge-oauth-states",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/refresh-oauth-tokens",
      "schedule": "30 3 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' https://*.supabase.co wss://*.supabase.co; frame-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
        },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "X-Permitted-Cross-Domain-Policies", "value": "none" }
      ]
    },
    {
      "source": "/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    }
  ],
  "redirects": [
    { "source": "/privacypolicy", "destination": "/privacy", "permanent": true },
    { "source": "/privacy-policy", "destination": "/privacy", "permanent": true },
    { "source": "/termsofservice", "destination": "/terms", "permanent": true },
    { "source": "/terms-of-service", "destination": "/terms", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/tiktokoqK4VOs7KRWPD6HowmYcFknpWtvZthbs.txt",
      "destination": "/tiktokoqK4VOs7KRWPD6HowmYcFknpWtvZthbs.txt"
    },
    {
      "source": "/termsofservice/tiktokXcaN82BdlRpeiVi4OCgeEdpqtjPkiYKP.txt",
      "destination": "/termsofservice/tiktokXcaN82BdlRpeiVi4OCgeEdpqtjPkiYKP.txt"
    },
    {
      "source": "/privacypolicy/tiktokbHGO5moTndtQNl5u2WIG21Gf3t2J3SnI.txt",
      "destination": "/privacypolicy/tiktokbHGO5moTndtQNl5u2WIG21Gf3t2J3SnI.txt"
    },
    {
      "source": "/oauth-complete",
      "destination": "/oauth-complete.html"
    },
    {
      "source": "/((?!api/|static/)[^.]*)",
      "destination": "/"
    }
  ]
}
