# Copy to .env and fill in. No quotes around values.
# Only REACT_APP_* values are sent to the browser; everything else stays on the server.

# --- Supabase (Project settings > API) ---------------------------------------
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-secret-key

# --- App ------------------------------------------------------------------------
# The portal's address, without a trailing slash. Locally: http://localhost:3000
APP_BASE_URL=https://www.portalomnyagrowth.com
# Other sites allowed to call the API, comma separated. Usually empty.
ADDITIONAL_ALLOWED_ORIGINS=
# Signs scheduled jobs. Generate with: openssl rand -hex 32
CRON_SECRET=
# Encrypts social account tokens. 64 hex characters (openssl rand -hex 32).
# Use production's key when pointing at the production database.
ENCRYPTION_KEY=

# --- Payouts (Stripe dashboard > Developers) -----------------------------------
STRIPE_SECRET_KEY=
# Starts with whsec_
STRIPE_WEBHOOK_SECRET=

# --- Email (Resend) ---------------------------------------------------------------
RESEND_API_KEY=
# Sender, e.g. Omnya Growth <noreply@mail.omnyagrowth.com>. Empty sends from onboarding@resend.dev.
RESEND_FROM_EMAIL=
# Gets an email when someone signs up and needs a role.
OWNER_NOTIFICATION_EMAIL=

# --- Social accounts ---------------------------------------------------------------
# Callback URLs default to APP_BASE_URL/api/auth/<platform>/callback. Set *_REDIRECT_URI only to override.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
# true: TikTok bonuses pay only on views read from the creator's connected account.
TIKTOK_VERIFIED_BONUS_ONLY=

# One Meta app serves Facebook and Instagram. Instagram login uses the app's Instagram App ID.
META_APP_ID=
META_APP_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
META_REDIRECT_URI=

YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=
