# Copy to .env for local development. Values unquoted. Only REACT_APP_* values reach the browser.

# -----------------------------------------------------------------------------
# Browser (required)
# -----------------------------------------------------------------------------
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-key

# -----------------------------------------------------------------------------
# Server (api/)
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Deployed URL, no trailing slash. Local: http://localhost:3000
APP_BASE_URL=https://www.portalomnyagrowth.com
# Extra CORS origins, comma separated
ADDITIONAL_ALLOWED_ORIGINS=

# openssl rand -hex 32
CRON_SECRET=your-cron-secret
# 64 hex chars; must match production when using the production database
ENCRYPTION_KEY=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Signup approval alerts
OWNER_NOTIFICATION_EMAIL=admin@yourcompany.com
RESEND_API_KEY=your-resend-api-key
# e.g. "Omnya Growth <noreply@mail.omnyagrowth.com>"; defaults to onboarding@resend.dev
RESEND_FROM_EMAIL=

# Rate limiting; disabled when unset
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# -----------------------------------------------------------------------------
# Social OAuth (redirect URIs default to ${APP_BASE_URL}/api/auth/<platform>/callback)
# -----------------------------------------------------------------------------
TIKTOK_CLIENT_KEY=your-tiktok-client-key
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret
TIKTOK_REDIRECT_URI=

# Public TikTok metrics and handle checks
SCRAPECREATORS_API_KEY=your-scrapecreators-api-key
# true: TikTok bonuses pay only on verified views
TIKTOK_VERIFIED_BONUS_ONLY=

# One Meta app for the Instagram, Facebook and Meta buttons
META_APP_ID=
META_APP_SECRET=
INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
META_REDIRECT_URI=

YOUTUBE_CLIENT_ID=your-youtube-client-id
YOUTUBE_CLIENT_SECRET=your-youtube-client-secret
YOUTUBE_REDIRECT_URI=
